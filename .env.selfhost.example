# Env file shared by docker-compose.selfhost.yml, docker-compose.selfhost.prod.yml
# and docker-compose.dev.yml — no FTPS server in any of them (manual upload
# from the UI only, no Ansible).
#
# Copy this to `.env` at the repo root (docker compose reads `.env`
# automatically) and fill in the values below. Generate every password with:
#   openssl rand -hex 24
# and the JWT secret with:
#   openssl rand -hex 32
# change to prod for prod usage
COMPOSE_FILE=docker-compose.selfhost.yml:docker-compose.dev.yml

# --- Images (docker-compose.selfhost.yml only) -----------------------------
# One full image reference per service (registry + tag included). Build and
# tag them all with scripts/build-selfhost-images.sh, then --push once these
# point at a real registry instead of the local tags below. Not read by
# docker-compose.dev.yml, which builds from source instead.
IMAGE_API=ghcr.io/you/addaxai-connect-api:latest
IMAGE_BULK_UPLOAD=ghcr.io/you/addaxai-connect-bulk-upload:latest
IMAGE_DETECTION=ghcr.io/you/addaxai-connect-detection:latest
IMAGE_CLASSIFICATION_DEEPFAUNE=ghcr.io/you/addaxai-connect-classification-deepfaune:latest
IMAGE_CLASSIFICATION_SPECIESNET=ghcr.io/you/addaxai-connect-classification-speciesnet:latest
IMAGE_NOTIFICATIONS=ghcr.io/you/addaxai-connect-notifications:latest
IMAGE_NOTIFICATIONS_EMAIL=ghcr.io/you/addaxai-connect-notifications-email:latest
IMAGE_MINIO=ghcr.io/you/addaxai-connect-minio:latest
IMAGE_MINIO_INIT=ghcr.io/you/addaxai-connect-minio-init:latest
IMAGE_FRONTEND=ghcr.io/you/addaxai-connect-frontend:latest

# --- Domain & TLS (docker-compose.selfhost.prod.yml only) ------------------
# Must already point at this server's public IP (an A record) before you
# start the stack, or the Let's Encrypt HTTP-01 challenge will fail. Still
# used below by CORS_ORIGINS/MINIO_PUBLIC_ENDPOINT even without the prod
# overlay, so keep it set to something for the plain HTTP base stack too.
DOMAIN_NAME=cam.example.com
LETSENCRYPT_EMAIL=you@example.com

# --- Database ---------------------------------------------------------
POSTGRES_USER=addaxai
POSTGRES_PASSWORD=changeme
POSTGRES_DB=addaxai_connect
DATABASE_URL=postgresql://addaxai:changeme@postgres:5432/addaxai_connect

# --- Redis ---------------------------------------------------------
REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@redis:6379/0

# --- MinIO (S3-compatible storage) ---------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
# Legacy/unused for image delivery (images go out via authenticated
# /api/images endpoints) but still read at startup, so keep it set.
MINIO_PUBLIC_ENDPOINT=https://cam.example.com/minio

# --- JWT ---------------------------------------------------------
JWT_SECRET=changeme

# --- CORS ---------------------------------------------------------
CORS_ORIGINS=https://cam.example.com

# --- Classification model ---------------------------------------------------------
# One of: deepfaune, speciesnet. Selects both the compose profile that
# starts (only the matching classification-* worker builds/runs) and the
# label the API uses in outbound integration payloads.
CLASSIFICATION_MODEL=deepfaune
COMPOSE_PROFILES=deepfaune

# --- Email (auth mails, invitations, alerts) ---------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=changeme
MAIL_FROM=you@example.com
ADMIN_EMAIL=you@example.com

# --- Misc ---------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=json
UVICORN_WORKERS=2
DEV_NOTIFY_EMAILS=
DEV_NOTIFY_CHAT_IDS=
DISK_ALERT_THRESHOLDS=80,90,95
