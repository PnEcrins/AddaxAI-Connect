# Garage image (keep in step with the FROM in Dockerfile.init).
GARAGE_IMAGE=dxflrs/garage:v2.5.0

# Public name of the S3 endpoint (DNS A record -> this server).
GARAGE_DOMAIN=s3.example.com
LETSENCRYPT_EMAIL=you@example.com

# openssl rand -hex 32
GARAGE_RPC_SECRET=
# openssl rand -base64 32
GARAGE_ADMIN_TOKEN=

# Space given to Garage on this node (used by init.sh for the layout).
GARAGE_CAPACITY=500G

# App key, optional. Empty: init.sh lets Garage generate one and prints it.
# Set: init.sh imports this one, so it can match the app's MINIO_ROOT_USER /
# MINIO_ROOT_PASSWORD. Format: GK + 24 hex (GK$(openssl rand -hex 12))
# and 64 hex (openssl rand -hex 32).
GARAGE_KEY_ID=
GARAGE_KEY_SECRET=
