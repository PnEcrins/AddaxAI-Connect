# Public name of the S3 endpoint (DNS A record -> this server).
GARAGE_DOMAIN=s3.example.com
LETSENCRYPT_EMAIL=you@example.com

# openssl rand -hex 32
GARAGE_RPC_SECRET=
# openssl rand -base64 32
GARAGE_ADMIN_TOKEN=

# Space given to Garage on this node (used by init.sh for the layout).
GARAGE_CAPACITY=500G
